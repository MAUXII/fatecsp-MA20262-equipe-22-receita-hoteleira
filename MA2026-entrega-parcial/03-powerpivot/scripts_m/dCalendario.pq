// dCalendario
let Inicio=#date(2025,1,1), Fim=#date(2025,12,31), Datas=List.Dates(Inicio,Duration.Days(Fim-Inicio)+1,#duration(1,0,0,0)), T=Table.FromList(Datas,Splitter.SplitByNothing(),{"Data"}), Tipo=Table.TransformColumnTypes(T,{{"Data",type date}}), Ano=Table.AddColumn(Tipo,"Ano",each Date.Year([Data]),Int64.Type), Mes=Table.AddColumn(Ano,"Mes",each Date.Month([Data]),Int64.Type), NomeMes=Table.AddColumn(Mes,"NomeMes",each Date.MonthName([Data],"pt-BR"),type text), AnoMes=Table.AddColumn(NomeMes,"AnoMes",each Date.ToText([Data],"yyyy-MM"),type text), MesInicio=Table.AddColumn(AnoMes,"Mes_Inicio",each Date.StartOfMonth([Data]),type date), Trimestre=Table.AddColumn(MesInicio,"Trimestre",each "T"&Text.From(Date.QuarterOfYear([Data])),type text), DiaSemana=Table.AddColumn(Trimestre,"DiaSemana",each Date.DayOfWeek([Data],Day.Monday)+1,Int64.Type), NomeDia=Table.AddColumn(DiaSemana,"NomeDia",each Date.DayOfWeekName([Data],"pt-BR"),type text), FimSemana=Table.AddColumn(NomeDia,"FimDeSemana",each [DiaSemana]>=6,type logical), Feriado=Table.AddColumn(FimSemana,"Feriado",each false,type logical) in Feriado