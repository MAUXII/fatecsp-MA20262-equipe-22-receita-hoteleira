// fReservas
let
 Origem=stg_Reservas_Bruto,
 SemLinhasEmBranco=Table.SelectRows(Origem,each not List.IsEmpty(List.RemoveMatchingItems(Record.FieldValues(Record.SelectFields(_,ColunasAlvo)),{"",null}))),
 SemReservaVazia=Table.SelectRows(SemLinhasEmBranco,each [ID_Reserva]<>null and Text.Trim(Text.From([ID_Reserva]))<>""),
 SemDiariasVazia=Table.SelectRows(SemReservaVazia,each [Diarias]<>null and [Diarias]<>0),
 DescontoNuloZero=Table.ReplaceValue(SemDiariasVazia,null,0,Replacer.ReplaceValue,{"Desconto"}),
 SemDuplicatasExatas=Table.Distinct(Table.Buffer(DescontoNuloZero),ColunasAlvo),
 DatasHoras=Table.TransformColumns(SemDuplicatasExatas,{{"Data_Checkin",fnData,type nullable date},{"Hora_Checkin",fnHora,type nullable time}}),
 SemDataInvalida=Table.SelectRows(DatasHoras,each [Data_Checkin]<>null),
 NoPeriodo=Table.SelectRows(SemDataInvalida,each [Data_Checkin]>=pDataInicio and [Data_Checkin]<=pDataFim),
 SemHoraInvalida=Table.SelectRows(NoPeriodo,each [Hora_Checkin]<>null),
 TiposPtBR=Table.TransformColumnTypes(SemHoraInvalida,{{"ID_Reserva",type text},{"Diarias",Int64.Type},{"Valor_Diaria",Currency.Type},{"Desconto",Currency.Type}},"pt-BR"),
 SemErrosDeTipo=Table.RemoveRowsWithErrors(TiposPtBR,{"Diarias","Valor_Diaria","Desconto"}),
 QtdEValorValidos=Table.SelectRows(SemErrosDeTipo,each [Diarias]>0 and [Valor_Diaria]<>null),
 TextosAparados=Table.TransformColumns(QtdEValorValidos,{{"Hotel",fnLimparTexto,type text},{"Acomodacao",fnLimparTexto,type text},{"Categoria",fnLimparTexto,type text},{"Pagamento",fnLimparTexto,type text},{"Canal",fnLimparTexto,type text}}),
 PrimeiraMaiuscula=Table.TransformColumns(TextosAparados,{{"Acomodacao",Text.Proper,type text},{"Categoria",Text.Proper,type text}}),
 PagamentoOficial=Table.TransformColumns(PrimeiraMaiuscula,{{"Pagamento",each fnValorOficial(_,lst_Pagamento[Pagamento]),type text}}),
 CanalOficial=Table.TransformColumns(PagamentoOficial,{{"Canal",each fnValorOficial(_,lst_Canal[Canal]),type text}}),
 ChaveHotel=Table.AddColumn(CanalOficial,"Chave_Hotel",each Text.Upper([Hotel]),type text),
 MesclaHotel=Table.NestedJoin(ChaveHotel,{"Chave_Hotel"},cad_DeParaChave,{"Chave_Hotel"},"DePara",JoinKind.LeftOuter),
 ExpandeHotel=Table.ExpandTableColumn(MesclaHotel,"DePara",{"Cod_Hotel"}),
 ComHotel=Table.SelectRows(ExpandeHotel,each [Cod_Hotel]<>null),
 ChaveAcomodacao=Table.AddColumn(ComHotel,"Chave_Acomodacao",each Text.Upper([Acomodacao]),type text),
 MesclaAcomodacao=Table.NestedJoin(ChaveAcomodacao,{"Chave_Acomodacao"},cad_AcomodacaoChave,{"Chave_Acomodacao"},"Cadastro",JoinKind.LeftOuter),
 ExpandeAcomodacao=Table.ExpandTableColumn(MesclaAcomodacao,"Cadastro",{"Cod"},{"Cod_Acomodacao"}),
 ComAcomodacao=Table.SelectRows(ExpandeAcomodacao,each [Cod_Acomodacao]<>null),
 OrdemOriginal=Table.Buffer(Table.Sort(ComAcomodacao,{{"Arquivo_Origem",Order.Ascending},{"Linha_Origem",Order.Ascending}})),
 SemDuplicatas=Table.Distinct(OrdemOriginal,{"ID_Reserva","Cod_Hotel","Cod_Acomodacao","Data_Checkin","Hora_Checkin","Diarias","Valor_Diaria","Desconto","Pagamento","Canal"}),
 ValorBruto=Table.AddColumn(SemDuplicatas,"Valor_Bruto",each Number.Round([Diarias]*[Valor_Diaria],2),Currency.Type),
 ValorLiquido=Table.AddColumn(ValorBruto,"Valor_Liquido",each Number.Round([Valor_Bruto]-[Desconto],2),Currency.Type),
 FormatoFinal=Table.SelectColumns(ValorLiquido,{"ID_Reserva","Data_Checkin","Hora_Checkin","Cod_Hotel","Cod_Acomodacao","Diarias","Valor_Diaria","Desconto","Valor_Bruto","Valor_Liquido","Pagamento","Canal","Arquivo_Origem","Linha_Origem"})
in FormatoFinal