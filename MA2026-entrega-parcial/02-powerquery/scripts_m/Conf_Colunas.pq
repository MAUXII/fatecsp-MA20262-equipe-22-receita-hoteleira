// Conf_Colunas
let Arquivos=Table.SelectRows(Folder.Files(pPastaReservas),each Text.Lower([Extension])=".xlsx" and not Text.StartsWith([Name],"~$")), Diagnostico=Table.AddColumn(Arquivos,"Faltantes",each let l=Excel.Workbook([Content],null,true), a=Table.SelectRows(l,each [Kind]="Sheet"){0}[Data], h=Table.PromoteHeaders(a,[PromoteAllScalars=true]), r=Table.RenameColumns(h,DeParaColunas,MissingField.Ignore) in Text.Combine(List.Difference(ColunasAlvo,Table.ColumnNames(r)),", ")), Falhas=Table.SelectRows(Diagnostico,each [Faltantes]<>""), Final=Table.SelectColumns(Falhas,{"Name","Faltantes"}) in Final