// fMetas
let Livro=Excel.Workbook(File.Contents(pArquivoMetas),null,true), Aba=Table.SelectRows(Livro,each [Kind]="Sheet"){0}[Data], Cabecalho=Table.PromoteHeaders(Aba,[PromoteAllScalars=true]), Longa=Table.UnpivotOtherColumns(Cabecalho,{"Cod_Hotel"},"AnoMes","Meta_Ocupacao"), Mes=Table.AddColumn(Longa,"Mes_Inicio",each Date.FromText([AnoMes]&"-01"),type date), Tipos=Table.TransformColumnTypes(Mes,{{"Cod_Hotel",type text},{"Meta_Ocupacao",type number}}), Dias=Table.AddColumn(Tipos,"Dias_Mes",each Date.DaysInMonth([Mes_Inicio]),Int64.Type), Hotel=Table.NestedJoin(Dias,{"Cod_Hotel"},dHotel,{"Cod_Hotel"},"Hotel",JoinKind.LeftOuter), Quartos=Table.ExpandTableColumn(Hotel,"Hotel",{"Qtd_Quartos"}), Capacidade=Table.AddColumn(Quartos,"Diarias_Disponiveis",each [Dias_Mes]*[Qtd_Quartos],Int64.Type), Meta=Table.AddColumn(Capacidade,"Meta_Diarias",each [Meta_Ocupacao]*[Diarias_Disponiveis],type number) in Meta